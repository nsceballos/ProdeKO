# ============================================================
# CONFIGURACIÓN PARA PRODE MUNDIAL 2026
# ============================================================
# Copiá este archivo como .env.local y completá los valores
# ============================================================

# ID de la hoja de cálculo de Google Sheets
# Lo encontrás en la URL: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Email de la cuenta de servicio de Google Cloud
# Lo obtenés al crear un Service Account en Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Clave privada de la cuenta de servicio (incluir las líneas BEGIN y END)
# Reemplazá los saltos de línea con \n (como se muestra abajo)
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# Clave secreta para JWT (mínimo 32 caracteres, generá una aleatoria)
# Podés usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_secret_jwt_key_here_minimum_32_chars_long
